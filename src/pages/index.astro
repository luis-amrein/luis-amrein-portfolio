---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroAntigravity from '../components/HeroAntigravity';
import BookProjects from '../components/BookProjects';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <div class="section-stack">
    <section class="hero shell slide-panel has-antigravity">
      <div class="hero-antigravity" aria-hidden="true">
        <HeroAntigravity client:only="react" />
      </div>
      <div>
        <h1>Making products make(s) sense.</h1>
      </div>
      <div class="hero-bottom">
        <div>
          <p class="hero-intro">
            I am a Product Manager in Berlin, currently shaping digital health products at Caspar
            Health. Previously carbon marketplaces and healthcare staffing. I like to build things.
            This site is where I’ll publish them, step by step.
          </p>
          <div class="button-row">
            <a class="button" href={`${base}work/`}>Explore selected work <span aria-hidden="true">↓</span></a>
            <a class="button secondary" href="mailto:luis.amrein@hotmail.de">Start a conversation</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section shell slide-over" aria-labelledby="selected-work">
      <div class="section-heading reveal">
        <h2 id="selected-work">Selected Work</h2>
      </div>
      <BookProjects client:load projects={projects.map((project) => ({ id: project.id, ...project.data }))} base={base} />
      <div class="button-row">
        <a class="button secondary" href={`${base}work/`}>View all case studies</a>
      </div>
    </section>
  </div>

  <section class="section shell" aria-labelledby="background">
    <div class="section-heading reveal">
      <h2 id="background">Background</h2>
    </div>
    <div class="about-grid reveal">
      <p class="hero-intro">
        My path into product started with engineering: a head-up display for automated vehicles,
        ergonomics, medical technology, and a knee prosthesis designed for humanitarian use.
      </p>
      <div>
        <p>
          Operations taught me how processes and incentives shape outcomes. Product management
          brought the pieces together: empathy, systems thinking, design, technology, and data.
        </p>
        <p>
          Today I use that mix to create alignment around complex problems and help teams move from
          uncertainty to a product people can actually use.
        </p>
        <a href={`${base}about/`}>More about my path and life outside work →</a>
      </div>
    </div>
  </section>

  <section class="personal-band">
    <div>
      <h2>Outside Work</h2>
    </div>
    <div>
      <p>
        Gravel rides to Brandenburg lakes, remote piano lessons from my mum, Portuguese practice, a variety
        of Urban Sports classes, mixing music, and making things for my flat.
      </p>
      <a class="button secondary" href={`${base}about/#outside-work`}>Meet the person behind the roadmap</a>
    </div>
  </section>
</BaseLayout>
