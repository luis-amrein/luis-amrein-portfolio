---
import { getCollection } from 'astro:content';
import MagazinePrototype from '../../components/prototype/MagazinePrototype';
import portrait from '../../assets/luis-portrait.jpg';
export function getStaticPaths(){ return import.meta.env.DEV ? [{params:{experiment:'magazine'}}] : []; }
const projects=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order).map(({id,data})=>({id,...data}));
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Magazine study — Luis Amrein</title></head><body><MagazinePrototype client:only="react" projects={projects} portrait={portrait.src} base={import.meta.env.BASE_URL}/></body></html>
