---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceShowcase from '../../components/DeviceShowcase.astro';
import { isExternalUrl, withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
const siteRoot = new URL(base, Astro.site).toString();
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const showcase = project.data.showcase;
const projectLink = project.data.link
  ? { href: withBase(project.data.link), external: isExternalUrl(project.data.link) }
  : undefined;

const creativeWorkSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${pageUrl}#case`,
  name: project.data.title,
  headline: project.data.title,
  description: project.data.summary,
  dateCreated: project.data.year,
  inLanguage: 'en',
  url: pageUrl,
  author: { '@id': `${siteRoot}#person` },
  creator: { '@id': `${siteRoot}#person` },
  about: project.data.tags,
  keywords: project.data.tags.join(', '),
  genre: project.data.eyebrow,
  abstract: project.data.challenge,
  creativeWorkStatus: project.data.outcomeLabel,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteRoot,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL(`${base}work/`, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: project.data.title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout
  title={`${project.data.title} — case study by Luis Amrein`}
  description={`${project.data.summary} Role: ${project.data.role}. Outcome: ${project.data.outcomeLabel}.`}
  ogType="article"
  jsonLd={[creativeWorkSchema, breadcrumbSchema]}
>
  <header class="page-hero shell">
    <p class="kicker">{project.data.eyebrow}</p>
    <h1 class="display-title">{project.data.title}</h1>
    <p class="lede">{project.data.summary}</p>
  </header>

  <div class="shell">
    <dl class="case-meta">
      <div>
        <dt>Role</dt>
        <dd>{project.data.role}</dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd>{project.data.year}</dd>
      </div>
      <div>
        <dt>Outcome</dt>
        <dd>{project.data.outcomeLabel}</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>{project.data.tags.join(' · ')}</dd>
      </div>
    </dl>
  </div>

  {
    showcase && showcase.length > 0 && (
      <DeviceShowcase
        items={showcase}
        title={project.data.showcaseTitle ?? 'Product in the hand'}
        label={project.data.showcaseLabel ?? 'Product visuals'}
      />
    )
  }

  <div class="case-body shell">
    <aside>
      <p class="section-label">The core challenge</p>
      <p>{project.data.challenge}</p>
      <div class="tag-row">
        {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      {project.data.status === 'needs-update' && (
        <p class="draft-note">
          Content review: this older project still needs updated dates, shareable screenshots, or a
          final metric before the portfolio is considered finished.
        </p>
      )}
      {projectLink && (
        <div class="button-row">
          <a
            class="button secondary"
            href={projectLink.href}
            target={projectLink.external ? '_blank' : undefined}
            rel={projectLink.external ? 'noopener noreferrer' : undefined}
          >
            {project.data.linkLabel ?? 'Open project'}
            {projectLink.external && <span aria-hidden="true"> ↗</span>}
          </a>
        </div>
      )}
    </aside>
    <article itemscope itemtype="https://schema.org/CreativeWork">
      <meta itemprop="name" content={project.data.title} />
      <meta itemprop="description" content={project.data.summary} />
      <Content />
      <div class="button-row">
        <a class="button secondary" href={`${base}work/`}>← All case studies</a>
        <a class="button" href="mailto:luis.amrein@hotmail.de">Discuss this work</a>
        {projectLink && (
          <a
            class="button secondary"
            href={projectLink.href}
            target={projectLink.external ? '_blank' : undefined}
            rel={projectLink.external ? 'noopener noreferrer' : undefined}
          >
            {project.data.linkLabel ?? 'Open project'}
            {projectLink.external && <span aria-hidden="true"> ↗</span>}
          </a>
        )}
      </div>
    </article>
  </div>
</BaseLayout>
