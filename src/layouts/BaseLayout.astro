---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Luis Amrein — Product Manager in Berlin',
  description = 'Product Manager in Berlin who builds prototypes and ships production-ready products. Case studies across digital health, sustainability marketplaces, and consumer apps.',
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteRoot = new URL(base, Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og-card.svg`, Astro.site).toString();
const relativePath = Astro.url.pathname.replace(base, '/');
const isWork = relativePath.startsWith('/work');
const isHome = relativePath === '/' || relativePath === '';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteRoot}#person`,
  name: 'Luis Amrein',
  givenName: 'Luis',
  familyName: 'Amrein',
  jobTitle: 'Product Manager',
  description:
    'Product Manager in Berlin with an engineering background. Builds prototypes to learn fast and ships production-ready software. Currently shaping digital health products at Caspar Health.',
  url: siteRoot,
  email: 'mailto:luis.amrein@hotmail.de',
  image: ogImage,
  sameAs: [
    'https://www.linkedin.com/in/luis-amrein/',
    'https://github.com/luis-amrein',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Caspar Health',
  },
  homeLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Berlin',
      addressCountry: 'DE',
    },
  },
  knowsAbout: [
    'Product management',
    'Product strategy',
    'Prototyping',
    'iOS development',
    'SwiftUI',
    'Digital health',
    'Marketplaces',
    'Experimentation',
    'A/B testing',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  name: 'Luis Amrein Portfolio',
  url: siteRoot,
  description,
  inLanguage: 'en',
  publisher: { '@id': `${siteRoot}#person` },
  author: { '@id': `${siteRoot}#person` },
};

const profilePageSchema = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      '@id': canonical.toString(),
      url: canonical.toString(),
      name: title,
      description,
      mainEntity: { '@id': `${siteRoot}#person` },
      isPartOf: { '@id': `${siteRoot}#website` },
    }
  : null;

const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const schemas = [personSchema, websiteSchema, profilePageSchema, ...extraSchemas].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Luis Amrein" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href={`${base}llms.txt`} title="LLM context" />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Luis Amrein" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Luis Amrein — Product Manager portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      schemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <title>{title}</title>
  </head>
  <body>
    <div class="cursor-wash" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href={base} aria-label="Luis Amrein, home">Luis Amrein</a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href={`${base}work/`} aria-current={isWork ? 'page' : undefined}>Work</a>
        <a href={`${base}about/`} aria-current={relativePath === '/about/' ? 'page' : undefined}>About</a>
        <a href="mailto:luis.amrein@hotmail.de">Contact</a>
      </nav>
      <span class="availability">Berlin, Germany</span>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-cta">
          <h2>Say hello.</h2>
          <a class="button" href="mailto:luis.amrein@hotmail.de">
            Send an email <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="footer-meta">
          <span>
            <a href="https://www.linkedin.com/in/luis-amrein/" rel="me">LinkedIn</a>
            &nbsp;·&nbsp;
            <a href="https://github.com/luis-amrein" rel="me">GitHub</a>
          </span>
        </div>
      </div>
    </footer>

    <script is:inline>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll('.reveal');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        reveals.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        reveals.forEach((item) => observer.observe(item));
      }

      const finePointer = window.matchMedia('(pointer: fine)').matches;
      if (!reduceMotion && finePointer) {
        let frame = 0;
        let targetX = 50;
        let targetY = 35;
        let currentX = 50;
        let currentY = 35;

        const render = () => {
          currentX += (targetX - currentX) * 0.12;
          currentY += (targetY - currentY) * 0.12;
          document.documentElement.style.setProperty('--cursor-x', `${currentX}%`);
          document.documentElement.style.setProperty('--cursor-y', `${currentY}%`);
          if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
            frame = requestAnimationFrame(render);
          } else {
            frame = 0;
          }
        };

        window.addEventListener(
          'pointermove',
          (event) => {
            targetX = (event.clientX / window.innerWidth) * 100;
            targetY = (event.clientY / window.innerHeight) * 100;
            if (!frame) frame = requestAnimationFrame(render);
          },
          { passive: true },
        );
      }

      const headlines = document.querySelectorAll(
        '.hero h1, .page-hero .display-title, .section-heading h2',
      );

      const wrapCharacters = (node, chars = []) => {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent ?? '';
          if (!text) return chars;
          const fragment = document.createDocumentFragment();
          for (const character of text) {
            const span = document.createElement('span');
            span.className = 'typewriter-char';
            span.textContent = character;
            fragment.appendChild(span);
            chars.push(span);
          }
          node.parentNode?.replaceChild(fragment, node);
        } else if (node.nodeType === Node.ELEMENT_NODE && !node.classList.contains('typewriter-caret')) {
          [...node.childNodes].forEach((child) => wrapCharacters(child, chars));
        }
        return chars;
      };

      const typeHeadline = (headline) => {
        if (headline.dataset.typed === 'true') return;
        headline.dataset.typed = 'true';
        headline.classList.add('typewriter');
        headline.closest('.reveal')?.classList.add('is-visible');

        const fullText = headline.textContent?.trim() ?? '';
        headline.setAttribute('aria-label', fullText);

        const chars = wrapCharacters(headline);
        if (reduceMotion || chars.length === 0) {
          chars.forEach((char) => char.classList.add('is-typed'));
          headline.classList.add('is-done');
          return;
        }

        const caret = document.createElement('span');
        caret.className = 'typewriter-caret';
        caret.setAttribute('aria-hidden', 'true');

        let index = 0;
        const tick = () => {
          if (index >= chars.length) {
            headline.classList.add('is-done');
            return;
          }
          const char = chars[index];
          char.classList.add('is-typed');
          char.after(caret);
          const value = char.textContent ?? '';
          index += 1;
          const delay = /[.,!?;:]/.test(value) ? 120 : value === ' ' ? 18 : 28;
          window.setTimeout(tick, delay);
        };
        if (chars[0]) chars[0].before(caret);
        window.setTimeout(tick, 180);
      };

      if (reduceMotion || !('IntersectionObserver' in window)) {
        headlines.forEach((headline) => typeHeadline(headline));
      } else {
        const typeObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                typeHeadline(entry.target);
                typeObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.35 },
        );
        headlines.forEach((headline) => typeObserver.observe(headline));
      }
    </script>
  </body>
</html>
