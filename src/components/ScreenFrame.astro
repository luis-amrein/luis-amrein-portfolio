---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolvedSrc = src.startsWith('http') || src.startsWith(base) ? src : `${base}${src.replace(/^\//, '')}`;
---

<figure class="screen-frame">
  <div class="screen-chrome">
    <div class="screen-chrome__bar" aria-hidden="true">
      <span class="screen-chrome__dot"></span>
      <span class="screen-chrome__dot"></span>
      <span class="screen-chrome__dot"></span>
    </div>
    <div class="screen-chrome__viewport">
      <img
        src={resolvedSrc}
        alt={alt}
        width="1200"
        height="680"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
